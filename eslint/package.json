{
    "name": "eslint-config-shaunburdick",
    "version": "11.1.0",
    "description": "Shaun's style configuration",
    "main": "index.js",
    "type": "module",
    "files": [
        "es6",
        "react",
        "typescript",
        "index.js"
    ],
    "scripts": {
        "fix": "npm run lint:fix",
        "lint:fix": "eslint . --fix",
        "lint": "eslint .",
        "test:rules": "node --test es6/*.test.js typescript/*.test.js",
        "test": "npm run lint && npm run test:rules"
    },
    "keywords": [
        "typescript",
        "lint",
        "eslint",
        "eslintconfig"
    ],
    "author": "Shaun Burdick <npm@shaunburdick.com>",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shaunburdick/style.git"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "peerDependencies": {
        "eslint": ">=10"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    },
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint-react/eslint-plugin": "^5.23.0",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsdoc": "^65.0.0",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "eslint-plugin-llm-core": "^0.37.0",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
        "eslint-plugin-security": "^4.1.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^76.0.0",
        "globals": "^17.12.0",
        "typescript-eslint": "^8.71.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "eslint": "^10.11.0",
        "react": "^19.3.0",
        "typescript": "^6.0.3"
    }
}
